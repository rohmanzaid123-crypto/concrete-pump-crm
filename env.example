# Frontend Supabase configuration (Vite exposes VITE_* values to the browser).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-side Supabase configuration used to verify user access tokens.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional server-side AI provider key. Never add this to a VITE_* variable.
GEMINI_API_KEY=
